---
import { getHeroData } from '../lib/queries';

const heroData = await getHeroData();

const badgeText = heroData?.badge || "🌸 Artisan Floral Studio";
const titleText = heroData?.heading || "Crafting unforgettable floral memories for every emotion.";
const descriptionText = heroData?.subheading || "Elevate life’s special moments with handpicked, eco-friendly flowers sourced directly from sustainable gardens. Guaranteed 7-day freshness.";
const ctaText = heroData?.ctaText || "Explore Collection";
const ctaLink = heroData?.ctaLink || "/shop";
const heroImg = heroData?.imageUrl || "https://images.unsplash.com/photo-1561181286-d3fee7d55364?auto=format&fit=crop&w=1000&q=80";
---

<section class="hero-section">
  <div class="container hero-grid">
    <!-- Hero Text Content -->
    <div class="hero-content">
      <div class="hero-tag">
        <span class="badge badge-rose">{badgeText}</span>
      </div>
      <h1 class="hero-title">
        {titleText}
      </h1>
      <p class="hero-description">
        {descriptionText}
      </p>

      <div class="hero-actions">
        <a href={ctaLink} class="btn btn-primary">
          {ctaText}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/categories/bouquets" class="btn btn-outline">
          View Bouquets
        </a>
      </div>

      <!-- Feature Strip -->
      <div class="hero-features-strip">
        <div class="hero-feature-item">
          <div class="hero-feature-icon">🚚</div>
          <div class="hero-feature-text">
            <h4>Same-Day Delivery</h4>
            <p>Order by 2:00 PM local</p>
          </div>
        </div>
        <div class="hero-feature-item">
          <div class="hero-feature-icon">🌿</div>
          <div class="hero-feature-text">
            <h4>7-Day Fresh Guarantee</h4>
            <p>Direct garden sourcing</p>
          </div>
        </div>
        <div class="hero-feature-item">
          <div class="hero-feature-icon">🎁</div>
          <div class="hero-feature-text">
            <h4>Gift Wrapped</h4>
            <p>Free custom greeting card</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Hero Media Image Showcase -->
    <div class="hero-media">
      <div class="hero-image-frame">
        <img
          src={heroImg}
          alt="Fresh Flower Arrangement"
          width="800"
          height="600"
          loading="eager"
        />
      </div>

      <!-- Floating Review Badge -->
      <div class="hero-float-card floating">
        <img
          src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80"
          alt="Customer Avatar"
          class="hero-float-avatar"
        />
        <div class="hero-float-text">
          <div style="color: #F4A261; font-size: 0.8rem; margin-bottom: 0.2rem;">★★★★★</div>
          <h5>"The bouquet was mesmerizing!"</h5>
          <p>— Sophia M., Verified Buyer</p>
        </div>
      </div>
    </div>
  </div>
</section>
