<div style="position: relative; max-width: 480px; width: 100%;">
  <input
    type="text"
    id="global-search-input"
    placeholder="Search for roses, lilies, orchids, bouquets..."
    style="width: 100%; padding: 0.85rem 1.25rem 0.85rem 3rem; border-radius: var(--radius-full); border: 1px solid var(--border-light); background-color: var(--bg-card); font-size: 0.95rem; outline: none; transition: border-color 0.2s;"
  />
  <svg
    style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; color: var(--text-muted);"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
</div>
