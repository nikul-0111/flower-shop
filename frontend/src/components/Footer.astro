---
---

<footer style="background-color: var(--bg-dark); color: #B3C6BA; padding: 4.5rem 0 2rem 0; margin-top: 5rem; border-top: 1px solid rgba(255,255,255,0.08);">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 3rem; margin-bottom: 3.5rem;">
      <!-- Column 1: Brand Info -->
      <div>
        <a href="/" class="brand-logo" style="color: #FFFFFF; margin-bottom: 1.25rem; display: inline-flex;">
          <svg class="brand-logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--rose-gold); width:28px; height:28px;">
            <path d="M12 2a5 5 0 0 0-5 5c0 2 1.5 3.5 3 5-2.5 0-4 1.5-4 4 0 3 2.5 5 6 5s6-2 6-5c0-2.5-1.5-4-4-4 1.5-1.5 3-3 3-5a5 5 0 0 0-5-5z"></path>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
          Bloomify
        </a>
        <p style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem;">
          Handcrafting moments of joy with eco-friendly blooms, sustainable farm-direct florals, and express nationwide delivery.
        </p>
        <div style="display: flex; gap: 1rem;">
          <a href="#" style="color: #FFF; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; transition: background 0.3s;" aria-label="Instagram">
            📷
          </a>
          <a href="#" style="color: #FFF; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; transition: background 0.3s;" aria-label="Facebook">
            📘
          </a>
          <a href="#" style="color: #FFF; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; transition: background 0.3s;" aria-label="Pinterest">
            📌
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h4 style="color: #FFFFFF; font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 1.25rem;">Explore Collections</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.9rem;">
          <li><a href="/categories/bouquets" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Fresh Bouquets</a></li>
          <li><a href="/categories/roses" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Signature Red Roses</a></li>
          <li><a href="/categories/wedding" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Wedding Floral Collections</a></li>
          <li><a href="/categories/birthday" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Birthday Flowers</a></li>
          <li><a href="/categories/plants" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Indoor Green Plants</a></li>
        </ul>
      </div>

      <!-- Column 3: Customer Care -->
      <div>
        <h4 style="color: #FFFFFF; font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 1.25rem;">Customer Care</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.9rem;">
          <li><a href="/about" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Flower Care Guide</a></li>
          <li><a href="/contact" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Track Your Order</a></li>
          <li><a href="/contact" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Same-Day Delivery Guarantee</a></li>
          <li><a href="/contact" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Frequently Asked Questions</a></li>
          <li><a href="/contact" style="color: inherit;" onmouseover="this.style.color='#E8A598'" onmouseout="this.style.color='inherit'">Support & Contact</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Studio Info -->
      <div>
        <h4 style="color: #FFFFFF; font-family: var(--font-serif); font-size: 1.15rem; margin-bottom: 1.25rem;">Visit Our Boutique</h4>
        <p style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 0.75rem;">
          📍 742 Gardenia Way, Floral District, CA 90210
        </p>
        <p style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 0.75rem;">
          📞 (800) 555-BLOOM
        </p>
        <p style="font-size: 0.9rem; line-height: 1.6;">
          ✉️ hello@bloomify-flowers.com
        </p>
      </div>
    </div>

    <div style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 1.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; font-size: 0.825rem;">
      <p>© {new Date().getFullYear()} Bloomify Flower Shop. All Rights Reserved. Crafted with care.</p>
      <div style="display: flex; gap: 1.5rem;">
        <a href="#" style="color: inherit;">Privacy Policy</a>
        <a href="#" style="color: inherit;">Terms of Service</a>
        <a href="#" style="color: inherit;">Cookie Settings</a>
      </div>
    </div>
  </div>
</footer>
